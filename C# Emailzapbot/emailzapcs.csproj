<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
  
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <Target Name="BuildExecutables" AfterTargets="Build">
    <Exec Command="dotnet publish -c Release --runtime win10-x64 -o ./release/OLOpen OLOPen.cs -p:PublishSingleFile=true" />
    <Exec Command="dotnet publish -c Release --runtime win10-x64 -o ./release/Program Program.cs -p:PublishSingleFile=true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" NoWarn="NU1701" />
    <PackageReference Include="Microsoft.Office.Interop.Outlook" Version="15.0.0" />
    <Compile Include="OLOpen.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
